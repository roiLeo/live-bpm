{
  "private": true,
  "scripts": {
    "dev": "nuxi dev",
    "build": "nuxi build",
    "start": "nuxi start",
    "lint": "eslint --ignore-path .gitignore --ext .js,.ts,.vue .",
    "lint:quiet": "eslint --quiet --ignore-path .gitignore --ext .js,.ts,.vue .",
    "lint:fix": "eslint --fix --quiet --ignore-path .gitignore --ext .js,.ts,.vue .",
    "test": "vitest run"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@nuxt/devtools": "4.0.0-beta.7",
    "@nuxt/eslint-config": "^1.17.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@nuxt/ui": "4.12.0",
    "@nuxtjs/i18n": "^10.6.0",
    "nuxt": "^4.6.2"
  },
  "packageManager": "pnpm@9.15.7"
}
